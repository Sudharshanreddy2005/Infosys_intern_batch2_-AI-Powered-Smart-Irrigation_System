FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
ARG FASTAPI_ORIGIN=http://backend:8000
ARG NEXT_PUBLIC_CROP_DISEASE_URL=http://localhost:8001
ENV FASTAPI_ORIGIN=${FASTAPI_ORIGIN}
ENV NEXT_PUBLIC_CROP_DISEASE_URL=${NEXT_PUBLIC_CROP_DISEASE_URL}
RUN npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
