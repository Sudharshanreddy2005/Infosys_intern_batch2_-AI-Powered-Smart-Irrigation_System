# The browser uses same-origin /api and /weather paths; Next.js proxies them.
# Set this when running Next.js outside Docker.
FASTAPI_ORIGIN=http://127.0.0.1:8000

# Independent crop disease detector service (separate from the main FastAPI app).
# Use the reachable host for the machine running the standalone detector.
CROP_DISEASE_ORIGIN=http://host.docker.internal:8001
NEXT_PUBLIC_CROP_DISEASE_URL=http://localhost:8001

# Leave empty to use the same-origin Next.js rewrites proxy.
NEXT_PUBLIC_API_URL=
